{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "apps/firebase-functions",
    "runtime": "nodejs22",
    "predeploy": ["pnpm --filter @fazole/firebase-functions build"]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 5041 },
    "functions": { "port": 5042 },
    "firestore": { "port": 5043 },
    "storage": { "port": 5045 },
    "ui": { "enabled": true, "port": 5044 }
  }
}

{
  "name": "fazole",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scrape:dryrun": "pnpm --filter @fazole/scraper dryrun",
    "scrape": "pnpm --filter @fazole/scraper scrape",
    "emu": "turbo build && firebase emulators:start",
    "emu:export": "firebase emulators:export ./firebase-export",
    "deploy": "turbo build && firebase deploy --only hosting",
    "deploy:all": "turbo build && firebase deploy"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  }
}
